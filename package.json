{
  "name": "virtual-fitting-room",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype virtual fitting room: saved avatar, demo catalog, static size try-on. Not a validated fit predictor.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:demo": "tsx scripts/generate-demo-assets.ts",
    "smoke": "node scripts/smoke-e2e.mjs",
    "build:static": "STATIC_EXPORT=1 next build",
    "check": "npm run typecheck && npm test && npm run build",
    "preview:static": "node scripts/serve-static.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
